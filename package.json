{
  "name": "dsh-portage",
  "version": "0.0.0",
  "private": true,
  "description": "Sync DeepSeek Harness sessions with other tools — one bidirectional plugin per tool",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "checkjs": "tsc --noEmit",
    "pack:core": "pnpm --filter dsh-portage-core exec npm pack",
    "pack:codex": "pnpm --filter dsh-portage-codex exec npm pack"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
